APP_ENV=production
PORT=8000
BRAND_CONFIG=brands/aksynxa.yaml
BRANDS_DIR=brands
AKSYNXA_DATA_DIR=/app/data

# Set a long random password before first production boot.
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
VERIFY_TOKEN=CHANGE_ME_META_WEBHOOK_VERIFY_TOKEN
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=

# PostgreSQL (compose service name shown in deployment/compose.yaml)
# Set ho to sessions + leads + chats + reminders + business users SAB
# PostgreSQL me jayenge; khali chhodo to local SQLite (data/aksynxa.db).
DATABASE_URL=postgresql://aksynxa:CHANGE_ME_DB_PASSWORD@db:5432/aksynxa
DB_POOL_MIN=1
DB_POOL_MAX=5

# Existing Google Sheets integration (optional)
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
SCHEDULER_TICK_SECONDS=30
SHEETS_RETRY_SECONDS=600

# Frontend origin, used when adding CORS policy in next hardening pass
FRONTEND_ORIGIN=https://YOUR-PROJECT.pages.dev
